# ====================================================================
# ZORENB LUXURY HAUTE HORLOGERIE - ENVIRONMENT VARIABLES
# Copy this file to .env.local and add your real keys.
# (Note: .env.local is automatically ignored in git and will NEVER be pushed)
# ====================================================================

# 1. Supabase (Database & Storage & Auth)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 2. PayOS (Vietnamese QR Payment Gateway)
PAYOS_CLIENT_ID=your-payos-client-id
PAYOS_API_KEY=your-payos-api-key
PAYOS_CHECKSUM_KEY=your-payos-checksum-key

# 3. Google AI Studio (AI Watch Concierge)
GEMINI_API_KEY=your-gemini-api-key
